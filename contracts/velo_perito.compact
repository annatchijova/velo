// VELO — Layer 6 (perito anonymous credential) + Layer 7 (blind second opinion).
//
// COMPILE STATUS (honest, mirroring velo.compact): COMPILED with compact
// 0.5.1 on 2026-08-28 — four circuits (registerCredential, proveCredential,
// commitOpinion, revealOpinion), prover and verifier keys and zkir generated
// under contracts/managed/velo_perito, exit 0, on a CPU with AVX2 (the zkir
// backend needs it; without AVX2 it dies with SIGILL after type-checking, a
// hardware limit, not a contract bug).
// Reproduce with:
//   compact compile contracts/velo_perito.compact contracts/managed/velo_perito
//
// RESOLVED AT COMPILE TIME (2026-08-28, compact 0.5.1): the membership check
// required the witness Merkle path to be `disclose()`d where it feeds
// merkleTreePathRoot (line in proveCredential) — the compiler traces that
// `checkRoot` over a witness path leaks a boolean about the witness and
// forces the disclosure to be declared. `disclose()` is a compile-time
// annotation, not publication: the path stays a witness and is never written
// to a ledger cell, so anonymity holds — only the fact that the assert passed
// is public. `Uint<0..4294967296>` comparisons, `persistentHash<Vector<4,
// Bytes<32>>>`, and the `x as Field as Bytes<32>` cast on a bounded int all
// compiled without further change.
//
// NOT YET DONE (stated plainly): the write path is not wired to a wallet or a
// deployment — registerCredential/proveCredential compile and have keys, but
// nothing in this build submits a transaction (same status as velo.compact's
// attest path). The off-chain TS engine (src/perito/) is what the tests and
// MCP exercise today.
//
// SEPARATE CONTRACT, ON PURPOSE. velo.compact (Layer 2, attestation) is
// already compiled, key-generated and red-teamed; its witnesses feed the
// generated bindings byte-for-byte. Layer 6 is a distinct proof (credential
// membership + validity) that composes with, but is separable from, the
// attestation. It gets its own contract and its own managed output so the
// Layer 2 artifact is never disturbed.
//
// WHAT THIS PROVES:
//   1. The prover's credential leaf is a member of the on-chain tree of
//      accredited examiners (MEMBERSHIP) — without revealing WHICH leaf, so
//      the examiner stays anonymous.
//   2. The leaf's validity window covers the attestation date (VALIDITY):
//      validFrom <= attestationDate <= validUntil.
// Membership and validity are TWO separate asserts, on purpose — the corpus
// (peritos-syntetic/) requires them to be distinguishable. VELO-PERITO-005
// is a member of the tree for all three of its attestations, but its
// VELO-006 attestation (2026-04-10) falls in a licensing gap: whichever span
// leaf the prover supplies, the validity asserts reject it, because no leaf
// exists whose window covers that date. Same examiner, three dates, three
// outcomes — decided by which span (if any) covers the date.
//
// LEAF RECONCILIATION (stated plainly): the on-chain leaf is a
// `persistentHash` value (this file). The off-chain registry (src/perito/
// registry.ts) builds a PARALLEL SHA-256 tree for the frontend/MCP to answer
// "accredited + valid at date" without the chain. The two roots are NOT
// required to be equal — the repo already keeps the off-chain evidence
// Merkle root separate from the on-chain attestation commitment. If a single
// shared root is ever wanted, the off-chain side must adopt the runtime's
// `persistentHash` encoding, which is not exported (the same caveat
// witnesses.ts records for the attestation commitment).
//
// LAYER 7 — BLIND SECOND OPINION (commitOpinion / revealOpinion). Two
// accredited examiners independently attest the same case_commitment; the
// contract records only AGREEMENT or CONTRADICTION of the verdicts, never
// identities or analyses. Blindness is enforced by commit-reveal: each commits
// a HIDING verdict commitment, and nothing is revealable until BOTH have
// committed (commitCount == 2), so the second examiner cannot copy the first.
// A per-(examiner, case) nullifier — a DIFFERENT domain separator from the
// credential leaf and the verdict commitment — stops one examiner opining
// twice, so two opinions are provably two distinct credentials. commitOpinion
// reuses the exact Layer 6 credential proof (assertValidCredential).

pragma language_version >= 0.22;

import CompactStandardLibrary;

// Verdict space, matching src/engine/scorer.ts and velo.compact. Local to this
// contract (a separate compilation unit from velo.compact).
export enum Verdict { NOISE, SUSPICION, MALICE, ABSTAIN }

// Per-case blind-second-opinion state (Layer 7). Exactly two opinions per case.
// Commitments are hiding until revealed; revealed<N> tracks which slot has been
// opened so a slot cannot be revealed twice.
struct CaseOpinions {
  commitCount: Uint<0..3>,
  commitment0: Bytes<32>,
  commitment1: Bytes<32>,
  revealCount: Uint<0..3>,
  verdict0: Verdict,
  verdict1: Verdict,
  revealed0: Boolean,
  revealed1: Boolean
}

// The tree of accredited examiners. Depth 16 is a ceiling with headroom for
// the synthetic corpus, not a claimed real maximum. Each leaf is a
// domain-separated persistentHash of (leafSecretKey, validFrom, validUntil):
// one leaf per validity SPAN, so a lapsed-and-re-licensed examiner
// (VELO-PERITO-005) occupies two leaves.
export ledger accreditedPeritos: MerkleTree<16, Bytes<32>>;

// How many credential-gated proofs have been produced. Public, monotonic.
// Also keeps the circuit above the minimum size (k >= 6) noted in the skill.
export ledger credentialAttestations: Counter;

// Layer 7 — blind second opinion. Opinions per case, and the nullifiers that
// stop one examiner opining twice on the same case.
export ledger caseOpinions: Map<Bytes<32>, CaseOpinions>;
export ledger usedOpinionNullifiers: Set<Bytes<32>>;
export ledger secondOpinionCommits: Counter;

// Private inputs — bodies live in src/witness/perito_witnesses.ts, never
// on-chain. The leaf secret key never leaves the examiner's machine; the
// circuit proves statements ABOUT it.
witness peritoLeafKey(): Bytes<32>;
witness findCredentialPath(leaf: Bytes<32>): MerkleTreePath<16, Bytes<32>>;
witness credentialValidFrom(): Uint<0..4294967296>;
witness credentialValidUntil(): Uint<0..4294967296>;

// Layer 7 commit-phase private inputs. The verdict is SECRET at commit time —
// that is what makes the commitment hiding — and the nonce is its per-opinion
// blinding factor (CSPRNG, persisted so its owner can reveal later).
witness opinionVerdict(): Verdict;
witness opinionNonce(): Bytes<32>;

// The leaf key derivation. Domain-separated so a perito credential leaf can
// never collide with a hash computed for another purpose. Recomputed inside
// the circuit rather than taken as an argument — the same "recompute, don't
// accept" discipline as velo.compact's commitment: a leaf passed in could
// mismatch the window the proof actually range-checks.
pure circuit credentialLeaf(leafKey: Bytes<32>, validFrom: Uint<0..4294967296>, validUntil: Uint<0..4294967296>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "velo:perito:credential:v1"),
    leafKey,
    validFrom as Field as Bytes<32>,
    validUntil as Field as Bytes<32>
  ]);
}

/**
 * Register an accredited examiner's credential leaf. One call per validity span.
 *
 * The leaf is COMPUTED IN-CIRCUIT from the same witnesses proveCredential uses
 * (peritoLeafKey, credentialValidFrom, credentialValidUntil), NOT taken as an
 * argument. This is the fix that makes register/prove consistent: the on-chain
 * leaf is a persistentHash whose encoding is not reproducible off-chain (the
 * generated PureCircuits is empty, and witnesses.ts records the same caveat for
 * the attestation commitment), so a caller could never compute the correct leaf
 * to pass in. Computing it here guarantees the registered leaf equals the leaf
 * proveCredential later recomputes.
 *
 * Self-registration model: whoever holds the leafSecretKey registers. The
 * registration transaction is public and linkable to the submitting wallet, but
 * it does not reveal the secret key, and anonymity is preserved at PROOF time —
 * proveCredential never reveals WHICH leaf validated.
 *
 * Insertion requires disclose() (the taint checker), but a MerkleTree insert
 * does not publish the leaf's preimage — only the root advances.
 */
export circuit registerCredential(): [] {
  const leaf = credentialLeaf(peritoLeafKey(), credentialValidFrom(), credentialValidUntil());
  accreditedPeritos.insert(disclose(leaf));
}

/**
 * Prove: "some accredited, currently-valid examiner attests as of
 * attestationDate" — without revealing which one.
 *
 * `attestationDate` is public (the date being attested is not secret); the
 * examiner's identity and window bounds are private witnesses.
 */
// The credential proof, factored out so Layer 7's commitOpinion reuses the
// exact same membership + validity checks Layer 6 proves. Internal (no export):
// callable only from other circuits in this contract.
circuit assertValidCredential(attestationDate: Uint<0..4294967296>): [] {
  const validFrom = credentialValidFrom();
  const validUntil = credentialValidUntil();

  // Recompute the leaf from the private key + window, then prove membership
  // of THAT leaf. Binding the window into the leaf is what makes the two
  // validity asserts below meaningful: the prover cannot range-check one
  // window while proving membership of a leaf built from another.
  const leaf = credentialLeaf(peritoLeafKey(), validFrom, validUntil);

  // (1) MEMBERSHIP — the leaf is in the accredited tree. Reveals only that
  // SOME leaf validated, never which (that is the anonymity property).
  assert(
    accreditedPeritos.checkRoot(merkleTreePathRoot<16, Bytes<32>>(disclose(findCredentialPath(leaf)))),
    "not an accredited examiner"
  );

  // (2) VALIDITY — the window covers the attestation date. Two separate
  // asserts so the failure reason distinguishes "before the window" from
  // "after the window", and so membership and validity are visibly two
  // checks. The VELO-PERITO-005 gap fails HERE for VELO-006: no span leaf's
  // window contains 2026-04-10.
  assert(validFrom <= attestationDate, "credential was not yet valid at the attestation date");
  assert(attestationDate <= validUntil, "credential had expired at the attestation date");
}

/**
 * Prove: "some accredited, currently-valid examiner attests as of
 * attestationDate" — without revealing which one.
 */
export circuit proveCredential(attestationDate: Uint<0..4294967296>): [] {
  assertValidCredential(attestationDate);
  credentialAttestations.increment(1);
}

// ===========================================================================
// Layer 7 — blind second opinion (commit-reveal + nullifier).
// ===========================================================================

// Deterministic nullifier for (examiner, case). A DIFFERENT domain separator
// from the credential leaf and the verdict commitment, so these hashes can
// never collide across purposes (compact skill: commitment vs nullifier).
pure circuit opinionNullifier(leafKey: Bytes<32>, caseCommitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "velo:perito:opinion-nullifier:v1"),
    leafKey,
    caseCommitment
  ]);
}

// Hiding + binding commitment to a verdict. The 32-byte nonce is the blinding
// factor: a verdict has only four values, so without the nonce the commitment
// would be brute-forcible. Domain-separated distinctly from the nullifier.
pure circuit verdictCommitment(verdict: Verdict, nonce: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "velo:perito:opinion-commit:v1"),
    verdict as Field as Bytes<32>,
    nonce
  ]);
}

/**
 * COMMIT phase. An accredited, currently-valid examiner publishes a HIDING
 * commitment to their verdict on `caseCommitment`, without revealing the
 * verdict or which examiner they are. The nullifier stops the same examiner
 * committing twice on this case, so the two opinions are provably two
 * distinct examiners.
 */
export circuit commitOpinion(caseCommitment: Bytes<32>, attestationDate: Uint<0..4294967296>): [] {
  // (1) Same credential proof as Layer 6 — membership + validity.
  assertValidCredential(attestationDate);

  // (2) Distinct-examiner nullifier.
  const nul = opinionNullifier(peritoLeafKey(), caseCommitment);
  assert(!usedOpinionNullifiers.member(disclose(nul)), "this examiner has already opined on this case");
  usedOpinionNullifiers.insert(disclose(nul));

  // (3) Record the hiding commitment in the next free slot. The verdict is a
  // secret witness at commit time; only its commitment becomes public.
  const commitment = verdictCommitment(opinionVerdict(), opinionNonce());
  const cc = disclose(caseCommitment);
  const prior = caseOpinions.member(cc) ? caseOpinions.lookup(cc) : default<CaseOpinions>;
  assert(prior.commitCount < 2, "this case already has two opinions — a blind second opinion is exactly a pair");
  const first = prior.commitCount == 0;
  caseOpinions.insert(cc, CaseOpinions {
    commitCount: (prior.commitCount + 1) as Uint<0..3>,
    commitment0: first ? disclose(commitment) : prior.commitment0,
    commitment1: first ? prior.commitment1 : disclose(commitment),
    revealCount: prior.revealCount,
    verdict0: prior.verdict0,
    verdict1: prior.verdict1,
    revealed0: prior.revealed0,
    revealed1: prior.revealed1
  });
  secondOpinionCommits.increment(1);
}

/**
 * REVEAL phase. Allowed ONLY once both opinions are committed — this is where
 * blindness is enforced: the second examiner could not have seen the first's
 * verdict, because nothing is revealable until both commitments are in. Opens
 * the committed, not-yet-revealed slot whose commitment matches (verdict,
 * nonce). `verdict` and `nonce` are public here (the reveal).
 */
export circuit revealOpinion(caseCommitment: Bytes<32>, verdict: Verdict, nonce: Bytes<32>): [] {
  // verdict and nonce are public in the reveal (this IS the opening), so they
  // are disclosed at the source; everything derived from them is then clean.
  const cc = disclose(caseCommitment);
  const revealedVerdict = disclose(verdict);
  const revealedNonce = disclose(nonce);

  assert(caseOpinions.member(cc), "no opinions committed for this case");
  const state = caseOpinions.lookup(cc);
  assert(state.commitCount == 2, "cannot reveal until both opinions are committed — that is what keeps the second opinion blind");

  const commitment = verdictCommitment(revealedVerdict, revealedNonce);
  const matches0 = (state.commitment0 == commitment) && !state.revealed0;
  const matches1 = (state.commitment1 == commitment) && !state.revealed1;
  assert(matches0 || matches1, "no committed, unrevealed opinion opens to this (verdict, nonce)");

  caseOpinions.insert(cc, CaseOpinions {
    commitCount: state.commitCount,
    commitment0: state.commitment0,
    commitment1: state.commitment1,
    revealCount: (state.revealCount + 1) as Uint<0..3>,
    verdict0: matches0 ? revealedVerdict : state.verdict0,
    verdict1: matches0 ? state.verdict1 : revealedVerdict,
    revealed0: matches0 ? true : state.revealed0,
    revealed1: matches0 ? state.revealed1 : true
  });
}
