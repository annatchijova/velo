// VELO — Capa 2: the gate.
//
// NOT YET COMPILED from this machine (no Compact toolchain here — per
// team decision, compilation happens after adversarial review, not
// through compile-fix-compile iteration). Written to the best of the
// compact skill's documented patterns; every place a specific compiler
// behavior could not be verified from here is flagged inline.
//
// What this proves:
//   1. The prover knows the private values behind the published
//      commitment (analysis fingerprint, custody tip, corroboration
//      count, salt).
//   2. The published verdict is genuinely bound to those values — it is
//      hashed into the commitment, so a given commitment can only ever
//      carry one verdict.
//   3. verdict == MALICE implies corroborationCount >= 2 (the Daubert
//      corroboration gate) — a constraint, not a promise.
//
// Out of scope for the circuit, on purpose: validating that
// `devil_advocate` is non-empty for MALICE. That is a free-text field —
// enforcing it here would mean hashing arbitrary-length witness strings
// inside a ZK circuit for no real security benefit (nothing prevents a
// low-effort string). It is enforced in src/engine/scorer.ts before a
// bundle is ever sealed.
//
// Also out of scope, stated plainly: this does NOT stop an expert who
// lies from the start. It stops the verdict or the corroboration count
// being changed *after* the analysis was sealed. Those are different
// claims and only the second one is made here.

pragma language_version >= 0.22;

import CompactStandardLibrary;

export enum Verdict { NOISE, SUSPICION, MALICE, ABSTAIN }

// Public ledger — everything here is plaintext on the network, forever.
export ledger caseVerdicts: Map<Bytes<32>, Verdict>;
export ledger attestationCount: Counter;

// Private inputs — bodies live in src/witness/witnesses.ts, never
// on-chain, never in cleartext inside the proof.
witness bundleFingerprint(): Bytes<32>;
witness bundleSalt(): Bytes<32>;

// The custody chain's tip. Part of the commitment so that truncating
// custody events changes the published value — without it, the anchor
// the documentation calls "the defense against truncation" would not
// cover custody at all.
witness custodyTip(): Bytes<32>;

// Number of INDEPENDENT SOURCES (distinct provenance roots), not detector
// categories. Stays private — how many sources corroborate is itself
// information about the case — but is hashed into the commitment, so it
// is fixed the moment the commitment is published. Bounded because
// Uint<0..n> is the documented type supporting ordering comparisons;
// 17 is a ceiling with headroom, not a claimed real maximum.
witness corroborationCountWitness(): Uint<0..17>;

// No constructor needed — Counter and Map both default to their zero
// value (0 / empty) per the compact skill's "Default Values" section.

/**
 * Attest a sealed analysis.
 *
 * The commitment is COMPUTED here rather than passed in and checked.
 * Passing it in would allow a mismatch between the value the prover
 * believes they are attesting and the values the proof actually covers;
 * computing it means the published commitment is, by construction, the
 * hash of exactly the witnesses that satisfied the constraints.
 *
 * WHY VERDICT AND COUNT ARE IN THE COMMITMENT (this was a real defect):
 * an earlier version committed only [fingerprint, custodyTip, salt] and
 * took `verdict` as a free public argument with `corroborationCount` as
 * an unbound witness. Nothing tied either of them to the commitment, so
 * a prover holding a legitimately sealed NOISE analysis could call
 * attest(C, MALICE) with a fabricated count of 5: the preimage check
 * passed, the Daubert check compared a number the prover had just typed
 * against itself, and the ledger recorded MALICE for an analysis that
 * said NOISE. The circuit's central claim was vacuous. Binding both
 * values into the commitment fixes that, and has a second effect worth
 * naming: because the verdict is hashed in, there is no way to produce
 * the same commitment with a different verdict, so an attestation
 * cannot be silently overwritten by re-attesting the same key. A
 * correction has to be a new, visibly different commitment.
 *
 * FLAGGED FOR COMPILE TIME — four things this file could not verify:
 *   1. `persistentHash<Vector<N, Bytes<32>>>` vs `persistentCommit(v,
 *      nonce)`. The skill's "Pattern 1: Commitment" uses the latter as
 *      the idiomatic hiding+binding helper. The Vector form is used here
 *      because it hashes several heterogeneous values together, which is
 *      what this commitment needs; brute-force risk is low either way
 *      since fingerprint and tip are already 32-byte hashes.
 *   2. Whether `Vector<6, Bytes<32>>` compiles and hashes as expected.
 *   3. Whether `verdict as Field as Bytes<32>` is a legal cast for an
 *      enum. The skill documents this chain for a Counter
 *      (`sequence as Field as Bytes<32>`) but not for an enum. If the
 *      compiler rejects it, the documented fallback is to hash a struct
 *      instead of a Vector, keeping each field in its own type.
 *   4. Whether `disclose()` is genuinely required (vs a no-op) on values
 *      that are already public — used anyway, following the skill's own
 *      bulletin-board example.
 *
 * KNOWN, NOT FIXED: re-attesting an identical (analysis, verdict, count)
 * triple recomputes the same commitment and increments attestationCount
 * again. Harmless to the record — the ledger entry is unchanged — but it
 * double-counts. Decide at integration whether to reject a commitment
 * already present.
 */
export circuit attest(verdict: Verdict): [] {
  const fingerprint = bundleFingerprint();
  const tip = custodyTip();
  const salt = bundleSalt();
  const corroborationCount = corroborationCountWitness();

  // The Daubert gate. Material implication written as a boolean rather
  // than a branch, so nothing depends on conditional-assert semantics
  // inside a circuit that could not be checked against the compiler.
  const maliceRequiresCorroboration =
    !(verdict == Verdict.MALICE) || corroborationCount >= (2 as Uint<0..17>);
  assert(maliceRequiresCorroboration, "MALICE requires at least 2 independent corroborating sources — the Daubert gate");

  // Domain-separated so this hash can never collide with one computed
  // for another purpose in this or any future circuit (compact skill,
  // "Domain separator is critical").
  const commitment = persistentHash<Vector<6, Bytes<32>>>([
    pad(32, "velo:attestation:v1"),
    fingerprint,
    tip,
    verdict as Field as Bytes<32>,
    corroborationCount as Field as Bytes<32>,
    salt
  ]);

  caseVerdicts.insert(disclose(commitment), disclose(verdict));
  attestationCount.increment(1);
}

/**
 * Public read helper — anyone can check whether a given commitment has
 * an attested verdict, without being the expert who sealed it. Mirrors
 * verify_commitment() in src/mcp/server.ts, but on-chain.
 */
export circuit lookupVerdict(caseCommitment: Bytes<32>): Verdict {
  assert(caseVerdicts.member(disclose(caseCommitment)), "no attestation exists for this commitment");
  return caseVerdicts.lookup(disclose(caseCommitment));
}
