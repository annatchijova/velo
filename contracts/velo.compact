// VELO — Capa 2: the gate.
//
// NOT YET COMPILED from this machine (no Compact toolchain here — per
// team decision, compilation happens later, after red-team review, on a
// machine that has it). Written to the best of the compact skill's
// documented patterns; flagged below wherever a specific compiler
// behavior could not be verified from here.
//
// What this proves, per 00_VELO_MASTER.md sec 4 Capa 2:
//   1. The prover knows a (bundleFingerprint, salt) pair whose commitment
//      is the one being published.
//   2. The published verdict is bound to that fingerprint (same witness
//      call, same circuit execution — they cannot be mixed and matched).
//   3. verdict == MALICE implies corroborationCount >= 2 (the Daubert
//      corroboration gate) — a boolean constraint, not a promise.
//
// Out of scope for the circuit, on purpose: validating that
// `devil_advocate` is non-empty for MALICE. That's a free-text field —
// enforcing it here would mean hashing/comparing arbitrary-length
// witness strings inside a ZK circuit for no real security benefit
// (nothing prevents a low-effort string). It's enforced in the TypeScript
// engine (src/engine/scorer.ts) before a bundle is ever sealed. The
// circuit's job is the part that's actually a cryptographic guarantee —
// the corroboration count comparison — not a content-quality check.

pragma language_version >= 0.22;

import CompactStandardLibrary;

export enum Verdict { NOISE, SUSPICION, MALICE, ABSTAIN }

// Public ledger — everything here is plaintext on the network, forever.
export ledger caseVerdicts: Map<Bytes<32>, Verdict>;
export ledger attestationCount: Counter;

// Private inputs — bodies live in TypeScript (src/mcp or a future wallet
// integration), never on-chain, never even in cleartext inside the proof.
witness bundleFingerprint(): Bytes<32>;
witness bundleSalt(): Bytes<32>;

// RED TEAM F3: the custody tip is now part of what the commitment binds.
// Previously the commitment covered only the analysis fingerprint, which
// excludes the custody chain by design — so an attacker could truncate
// custody events, recompute the (public) bundleHash, and the on-chain
// value would be unchanged. The documents called this commitment the
// "defense against truncation" while it did not cover custody at all.
// Binding both means a replayed identical analysis still matches
// (the point of having a separate fingerprint) AND the custody history
// is anchored.
witness custodyTip(): Bytes<32>;

// Number of INDEPENDENT SOURCES (distinct provenance roots), not detector
// categories — see red team F2 and src/engine/scorer.ts. Bounded so `>=`
// is well-defined: per the compact skill sec 3, Uint<0..n> supports
// ordering comparisons, plain Uint<n> is not documented to. 17 is an
// arbitrary ceiling with headroom; it does not claim a real maximum.
witness corroborationCountWitness(): Uint<0..17>;

// No constructor needed — Counter and Map both default to their zero
// value (0 / empty) per the compact skill's "Default Values" section;
// an explicit `attestationCount.increment(0)` would be redundant.

/**
 * Attest that `caseCommitment` corresponds to a sealed bundle the prover
 * actually holds, and that if the declared verdict is MALICE, at least
 * two independent sources corroborate it.
 *
 * FLAGGED FOR REVIEW / COMPILE TIME: the commitment below computes
 * persistentHash over a 3-element vector [fingerprint, custodyTip, salt]
 * — extended from the 2-element [fingerprint, salt] form documented in
 * 00_VELO_MASTER.md sec 5 after red team F3 showed that form left the
 * custody chain unanchored. Three open questions for the compiler:
 *   1. persistentHash(vector) vs persistentCommit(value, nonce) — the
 *      compact skill's "Pattern 1: Commitment" uses the latter, which is
 *      the idiomatic stdlib helper for hiding+binding. Both should be
 *      equivalent in spirit; brute-force risk is low either way because
 *      fingerprint and tip are already 32-byte hashes, not small values.
 *   2. Whether Vector<3, Bytes<32>> compiles and hashes as expected.
 *   3. Whether disclose() is genuinely required (vs a no-op) on values
 *      that are already public circuit arguments — used it anyway
 *      because the skill's own bulletin-board example does.
 */
export circuit attest(caseCommitment: Bytes<32>, verdict: Verdict): [] {
  const fingerprint = bundleFingerprint();
  const tip = custodyTip();
  const salt = bundleSalt();
  const corroborationCount = corroborationCountWitness();

  // F3: three-element commitment — analysis identity, custody history,
  // and the blinding salt. Truncating custody now changes the commitment,
  // so the on-chain record actually anchors what the docs claim it does.
  const computedCommitment = persistentHash<Vector<3, Bytes<32>>>([fingerprint, tip, salt]);
  assert(computedCommitment == caseCommitment, "commitment does not match the known bundle fingerprint, custody tip and salt");

  // Material implication, not a branch: (verdict == MALICE) => (corroborationCount >= 2).
  // Written as a boolean so there is no dependence on conditional-assert
  // semantics inside the circuit, which this build could not verify
  // against the actual compiler. Pure boolean/comparison operators are
  // documented as supported; this avoids relying on anything that isn't.
  const maliceRequiresCorroboration =
    !(verdict == Verdict.MALICE) || corroborationCount >= (2 as Uint<0..17>);
  assert(maliceRequiresCorroboration, "MALICE requires at least 2 independent corroborating sources — the Daubert gate");

  caseVerdicts.insert(disclose(caseCommitment), disclose(verdict));
  attestationCount.increment(1);
}

/**
 * Public read helper — anyone can check whether a given case_commitment
 * has an attested verdict, without needing to be the perito who sealed
 * it. Mirrors verify_commitment() in src/mcp/server.ts, but on-chain.
 */
export circuit lookupVerdict(caseCommitment: Bytes<32>): Verdict {
  assert(caseVerdicts.member(disclose(caseCommitment)), "no attestation exists for this commitment");
  return caseVerdicts.lookup(disclose(caseCommitment));
}
