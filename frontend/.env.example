# VELO frontend — optional environment variables.
# No secrets are required to run the demo.

# Default Midnight network for wallet connect:
#   preview | undeployed (local node) | preprod | mainnet
# preview is the Hack Buenos Aires hackathon's official network (confirmed
# in the kickoff talk, Jay Albert) — do not default to preprod.
NEXT_PUBLIC_WALLET_NETWORK=preview
