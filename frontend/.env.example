# VELO frontend — optional environment variables.
# No secrets are required to run the demo.

# Default Midnight network for wallet connect:
#   preview | undeployed (local node) | preprod | mainnet
# preview is the Hack Buenos Aires hackathon's official network (confirmed
# in the kickoff talk, Jay Albert) — do not default to preprod.
NEXT_PUBLIC_WALLET_NETWORK=preview

# --- Persistence (MVP Phase 3) — all optional. With none of these set the
# app runs in demo mode: seals are computed but not stored.

# Which database engine the adapter uses: neon | cloudsql
DB_ADAPTER=neon

# Postgres connection string (Neon or Cloud SQL).
DATABASE_URL=

# Secret used to sign session JWTs. Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
