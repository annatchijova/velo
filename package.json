{
  "name": "velo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VELO — zero-knowledge forensic attestation on Midnight",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/tests/*.test.js",
    "simulate": "tsc -p . && node dist/src/simulate.js",
    "web": "tsc -p . && node dist/src/web/server.js",
    "prepare": "husky"
  },
  "workspaces": [
    "frontend"
  ],
  "exports": {
    "./*": "./dist/src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "typescript": "^5.6.0"
  }
}
